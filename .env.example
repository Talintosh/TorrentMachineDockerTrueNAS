# Copy to .env and adjust for your host.

# Host directory bind-mounted as the container's media library.
HOST_MEDIA_PATH=./media

# Where that directory appears inside the container. The entrypoint also
# watches MEDIA_PATH/MetaInput for incoming .torrent files.
MEDIA_PATH=/mnt/media

# Ownership applied to the bind-mounted config/downloads directories.
PUID=1000
PGID=1000

# qBittorrent Web UI port (host and container).
QBT_WEBUI_PORT=9000

# LAN allowed to reach the Web UI through the kill-switch.
LAN_SUBNET=192.168.1.0/24
